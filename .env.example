# Backend runtime
FORECAST_BUST_DATA_ROOT=/absolute/path/to/validated/runtime-data
FORECAST_BUST_CORS_ORIGINS=http://localhost:5173
COPILOT_CACHE_PATH=/absolute/writable/path/copilot-cache.sqlite

# Optional downstream explanation service. Core P0 remains available when false.
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
COPILOT_PROMPT_VERSION=copilot-v1
COPILOT_TIMEOUT_SECONDS=8
COPILOT_OUTPUT_TOKEN_LIMIT=500
COPILOT_RATE_LIMIT_PER_MINUTE=10
COPILOT_CACHE_MAX_ENTRIES=500
